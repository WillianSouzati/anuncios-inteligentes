# Exemplo de variáveis de ambiente do projeto Anúncios Inteligentes.
# Copie este arquivo para .env e preencha com os valores reais do seu projeto.
# NUNCA coloque valores reais neste arquivo — ele é versionado no repositório.

# URL do projeto Supabase (pública, segura para o navegador)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# Mesmas variáveis expostas ao frontend (prefixo VITE_)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# Chave da API do Google Gemini — NUNCA fica neste arquivo.
# Ela é configurada exclusivamente nos Secrets do projeto (backend),
# onde é lida pela função de servidor via process.env.GEMINI_API_KEY.
